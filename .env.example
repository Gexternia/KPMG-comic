# Claves de Gemini. La segunda es opcional: reparte la carga y sirve de respaldo.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Modelos (opcional). gemini-2.5-flash-image dejará de funcionar como pronto el 15/03/2027.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Protege /api/metrics. Sin este valor el endpoint responde 404.
# METRICS_TOKEN=

# Valores por defecto; descomenta solo lo que quieras cambiar.
# MAX_CONCURRENT_COMIC_GENERATIONS=4
# MAX_PENDING_COMIC_REQUESTS=20
# CONCURRENCY_WAIT_TIMEOUT_MS=90000
# AI_REQUEST_TIMEOUT_MS=90000
# COMIC_DEADLINE_MS=270000
# MAX_PANEL_ATTEMPTS=3
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_MS=60000
# Tope de gasto: llamadas de imagen por hora en todo el servidor (6 por cómic).
# MAX_IMAGE_CALLS_PER_HOUR=1800
# PANEL_CACHE_TTL_MS=1800000
# Un cómic real ocupa unos 21 MB: el valor por defecto guarda unos 6 cómics.
# PANEL_CACHE_MAX_BYTES=134217728
